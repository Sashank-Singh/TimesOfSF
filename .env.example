# LLM: use Fireworks OR Gemini (not both required). If both keys exist, Fireworks wins unless LLM_PROVIDER=gemini.
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY="fw_..."
# Optional overrides (defaults are OpenAI-compatible Fireworks inference):
# FIREWORKS_BASE_URL="https://api.fireworks.ai/inference/v1"
# FIREWORKS_MODEL="accounts/fireworks/models/llama-v3p1-8b-instruct"

# GEMINI_API_KEY="..."  # only if LLM_PROVIDER=gemini or you use Gemini-only

# Required: Neon (or any Postgres) connection string for the app + pipeline.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# APP_URL: Public site URL (links, callbacks). On Coolify use your real domain, e.g. https://timesofsf.com
# (Coolify also sets COOLIFY_URL / COOLIFY_FQDN if APP_URL is unset.)
APP_URL="https://www.timesofsf.com"

# Custom domain (e.g. www.timesofsf.com): that hostname must reach the SAME Coolify app that runs Express
# (`server:start`). If www only serves a static export elsewhere, /api/posts returns 404 and the feed is empty.
# Fix: point www DNS/proxy to this Coolify service, or set VITE_API_URL to your real API host + CORS_ALLOWED_ORIGINS.

# VITE_API_URL: Leave unset for the default Docker/Coolify deploy (Express serves /api + static from one host).
# Only set this if the browser must call a different API origin (then configure CORS on that API).
# If you set it to the same host as the site (e.g. https://www.timesofsf.com), the app uses same-origin `/api` anyway.
# VITE_API_URL="https://api.example.com"
#
# If Coolify still has VITE_API_URL=https://timesofsf.onrender.com, remove it from Build Variables and redeploy.
# (Current client code also ignores *.onrender.com in production so same-origin is used.)

# VITE_PUBLIC_SITE_URL: Optional. Canonical / Open Graph base when it must differ from the browser origin (rare).
# VITE_PUBLIC_SITE_URL="https://timesofsf.com"

# Split frontend + API: browser origins allowed to call this server (comma-separated, no trailing slash).
# Required when www.timesofsf.com loads but API is on another host (e.g. Render/Coolify).
# CORS_ALLOWED_ORIGINS="https://www.timesofsf.com,https://timesofsf.com"

# Owner-only terminal article editor: npm run admin:articles
# Random string 12+ chars; never commit the real value.
OWNER_CLI_SECRET="change-me-min-12-chars"

# Owner-only browser form for "paste URL → publish" (Express HTML, not linked from the public React app).
# Use a long random path. If unset, no HTML page is served (POST /api/admin/article-from-url still works with curl).
# OWNER_ADMIN_UI_PATH="/ingest-9f2c1a8e7d4b6c3a/article"

# Pipeline scheduling: by default when Inngest is enabled the in-process setInterval timer is OFF.
# Set ALLOW_INTERNAL_CRON_WITH_INNGEST=true to run both (acts as a fallback if Inngest Cloud cron drops).
# ALLOW_INTERNAL_CRON_WITH_INNGEST=false
